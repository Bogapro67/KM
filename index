<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">

    <title>Estructura con Columnas</title>
    <style>
        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background-color: #dd0f0f;
            padding: 10px 20px;
        }

        /* Estilo para controlar el tamaño fijo del logotipo pequeño */
        .logo-pequeno {
            width: 500px;
            /* Ajusta el tamaño que desees */
            height: auto;
            display: block;
        }

        /* Estilo para que la imagen de la cabecera sea responsiva y no se desborde */


        .logo-cabecera {
            max-width: 100%;
            height: auto;
            display: block;
            margin-bottom: 15px;
            /* Espacio entre la imagen y el título */
        }

        .barra-navegacion{
            display: flex;
            gap: 15px;
            margin-top: 10px;
        }

        main {
            display: flex;
            gap: 20px;

        }

        aside {
            width: 25%;

            background-color: #e2b918;
            padding: 15px;
        }


        section {
            width: 75%;
            background-color: #ffffff;
            padding: 15px;
        }

        .boton-nav {
            text-decoration: none;
            color: rgba(234, 0, 0, 0.914);
            background-color: rgb(250, 250, 250);
            padding: 6px 12px;
            border-radius: 10px;
            font-size: 14PX;
            font-family: sans-serif;
            transition: background-color 0.6s;
        }

        .boton-nav:hover {
            background-color: rgb(255, 255, 255);
            color: rgb(228, 13, 13);
        }

        /* Estilos para el contenedor del anuncio */
        .bloque-anuncio {
            margin-top: 20px;
            padding: 10px;
            background-color: #ffffff;
            border: 1px dashed #ccc;
            text-align: center;
        }

        .bloque-anuncio img {
            max-width: 100%;
            height: auto;
            display: block;
            margin: 0 auto;
        }
    </style>
</head>

